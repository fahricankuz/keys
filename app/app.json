{
  "expo": {
    "name": "anahtar",
    "slug": "anahtar",
    "scheme": "anahtar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
