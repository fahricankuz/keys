    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^11.0.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web --output-dir dist && node scripts/harden-html.mjs dist",
    "build:web:maps": "expo export -p web --output-dir dist --source-maps && node scripts/harden-html.mjs dist && node scripts/sentry-sourcemaps.mjs dist",
    "build:hostinger": "npm run build:web:maps && node scripts/well-known.mjs dist && rm -rf ../hostinger-site && cp -r dist ../hostinger-site",
    "build": "npm run build:web",
    "magaza:durum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/magaza/asc-durum.mjs",
    "magaza:asc-fiyat": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/magaza/asc-abonelik-fiyatlari.mjs",
    "magaza:play-abonelik": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/magaza/play-abonelikler.mjs",
    "magaza:play-yukle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/magaza/play-yukle.mjs"
  },
  "private": true,
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
