{
  "name": "evim",
  "version": "0.4.0",
  "private": true,
  "description": "Kiracı ve mülk sahibi için kira yönetimi: web, iOS ve Android",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs 8000",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build": "npm ci --prefix app && npm run build --prefix app && rm -rf dist && cp -r app/dist dist",
    "build:pwa": "node scripts/build.mjs",
    "build:native": "node scripts/build.mjs --native && cap sync",
    "android": "npm run build:native && cap open android",
    "ios": "npm run build:native && cap open ios",
    "db:yeni": "node scripts/db-yeni.mjs",
    "db:derle": "node scripts/db-derle.mjs",
    "db:kontrol": "node scripts/db-derle.mjs --kontrol"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "@supabase/supabase-js": "^2.119.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
